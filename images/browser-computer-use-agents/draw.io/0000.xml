        <mxCell id="p3s" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6A80;" value="Standard software approval was not designed for this class of principal" vertex="1">
          <mxGeometry height="14" width="356" x="822" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p3div" parent="1" style="line;strokeColor=#FFCA2C;fillColor=none;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="4" width="368" x="816" y="118" as="geometry" />
        </mxCell>
        <mxCell id="p3b" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#7A6000;spacingLeft=4;spacingTop=4;whiteSpace=wrap;" value="Standard approval asks: &#xa;Is vendor reputable? Certified? Compliant jurisdiction? &#xa;&#xa;Browser agent governance asks: &#xa;What sessions will it inherit? How do we detect an unauthorized action? Who owns the liability? How does it appear in identity audits? &#xa;&#xa;The agent can pass every left-column question and leave every right-column question unanswered." vertex="1">
          <mxGeometry height="134" width="362" x="822" y="126" as="geometry" />
        </mxCell>
        <mxCell id="p4bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#FFCA2C;" value="" vertex="1">
