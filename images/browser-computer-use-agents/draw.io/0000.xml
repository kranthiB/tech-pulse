        <mxCell id="p5b" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#333D4D;spacingLeft=4;spacingTop=4;whiteSpace=wrap;" value="Same-Origin policy protects human users from cross-tab attacks. &#xa;&#xa;Browser agents undermine this by design: reading one authenticated session and acting in another is their normal workflow. &#xa;&#xa;A successful injection in any context the agent visits can reach every other open session. &#xa;&#xa;The leading vendor has acknowledged this may never be fully patched." vertex="1">
          <mxGeometry height="134" width="370" x="418" y="332" as="geometry" />
        </mxCell>
