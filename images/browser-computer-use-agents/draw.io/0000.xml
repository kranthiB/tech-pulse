        </mxCell>
        <mxCell id="p2s" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6A80;" value="SWG, CASB, EDR, DLP all operate at the wrong layer" vertex="1">
          <mxGeometry height="14" width="364" x="418" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p2div" parent="1" style="line;strokeColor=#E0E8F4;fillColor=none;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="4" width="376" x="412" y="118" as="geometry" />
        </mxCell>
        <mxCell id="p2b" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#333D4D;spacingLeft=4;spacingTop=4;whiteSpace=wrap;" value="SWG: traffic over HTTPS to a sanctioned app looks normal. &#xa;&#xa;CASB: agents use the UI, not APIs. No API call, no event. &#xa;&#xa;EDR: sanctioned browser at higher velocity is not anomalous. &#xa;&#xa;DLP: SaaS-to-SaaS data movement inside the perimeter may not trigger a rule.  From every existing control: a productive employee having a good day." vertex="1">
          <mxGeometry height="134" width="370" x="418" y="126" as="geometry" />
        </mxCell>
