        <mxCell id="p1b" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#333D4D;spacingLeft=4;spacingTop=4;whiteSpace=wrap;" value="A browser agent&#39;s effective access is not what the organization granted to the agent. &#xa;&#xa;It is what the organization granted to the employee across every system that employee is logged into simultaneously. &#xa;&#xa;For a knowledge worker: email, CRM, code repos, HR, finance, cloud console, messaging, and more. All at once, with no separate login." vertex="1">
          <mxGeometry height="134" width="362" x="22" y="126" as="geometry" />
        </mxCell>
