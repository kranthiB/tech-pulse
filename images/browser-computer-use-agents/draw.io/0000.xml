        </mxCell>
        <mxCell id="p4b" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#7A6000;spacingLeft=4;spacingTop=4;whiteSpace=wrap;" value="The four sequential mistakes: &#xa;1. Deploy first, govern second &#xa;2. Trust vendor logs as architectural controls &#xa;3. Assign to security as a monitoring problem &#xa;4. Entrench adoption before addressing governance &#xa;&#xa;Each creates conditions for the next. &#xa;The chain only breaks before step 1." vertex="1">
          <mxGeometry height="134" width="362" x="22" y="332" as="geometry" />
        </mxCell>
