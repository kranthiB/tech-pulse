        <mxCell id="p1s" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6A80;" value="The agent inherits every authenticated session, not just the one you authorized" vertex="1">
          <mxGeometry height="14" width="356" x="22" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p1div" parent="1" style="line;strokeColor=#E0E8F4;fillColor=none;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="4" width="368" x="16" y="118" as="geometry" />
