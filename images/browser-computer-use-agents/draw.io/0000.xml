        <mxCell id="p4s" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6A80;" value="Deploy first, govern second, then discover the gap is architectural" vertex="1">
          <mxGeometry height="14" width="356" x="22" y="306" as="geometry" />
        </mxCell>
        <mxCell id="p4div" parent="1" style="line;strokeColor=#FFCA2C;fillColor=none;strokeWidth=1;" value="" vertex="1">
