        <mxCell id="m2b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#7A6000;whiteSpace=wrap;" value="Vendor logging tells the organization what the agent did according to the agent. It does not verify what the agent had access to or audit what it chose not to log. Vendor controls operate inside the agent&#39;s own trust boundary. They are not an independent check; they are a self-report." vertex="1">
