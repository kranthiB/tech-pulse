        <mxCell id="t1hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;" value="Session Inheritance at Scale" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="84" as="geometry" />
        </mxCell>
        <mxCell id="t1bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#FFCA2C;" value="" vertex="1">
          <mxGeometry height="72" width="1111" x="28" y="128" as="geometry" />
        </mxCell>
        <mxCell id="t1b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#7A6000;whiteSpace=wrap;" value="The agent operates using the session tokens and cookies the user already established. Its effective access is not what the organization granted to the agent; it is what the organization granted to the employee across every system that employee is logged into simultaneously. The two numbers are structurally different and almost never the same." vertex="1">
          <mxGeometry height="64" width="1083" x="44" y="132" as="geometry" />
        </mxCell>
        <mxCell id="t2hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="36" width="1111" x="28" y="212" as="geometry" />
        </mxCell>
        <mxCell id="t2hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;" value="Same-Origin Policy Collapse" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="212" as="geometry" />
        </mxCell>
        <mxCell id="t2bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#FFCA2C;" value="" vertex="1">
          <mxGeometry height="80" width="1111" x="28" y="256" as="geometry" />
        </mxCell>
        <mxCell id="t2b" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#7A6000;spacingLeft=4;spacingTop=4;whiteSpace=wrap;" value="Standard browsers prevent scripts in one tab from reading data in another. A browser agent undermines this by design: reading content in one authenticated tab and acting on it in another is a normal part of its workflow. The agent sits above all the pages, not inside any one of them.  This means a successful prompt injection in any one context the agent visits can instruct it to act across every other open session." vertex="1">
          <mxGeometry height="72" width="1083" x="44" y="260" as="geometry" />
        </mxCell>
        <mxCell id="t3hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="36" width="1111" x="28" y="348" as="geometry" />
        </mxCell>
        <mxCell id="t3hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;" value="Indirect Prompt Injection Through Rendered Content" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="348" as="geometry" />
        </mxCell>
        <mxCell id="t3bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#FFCA2C;" value="" vertex="1">
          <mxGeometry height="80" width="1111" x="28" y="392" as="geometry" />
        </mxCell>
        <mxCell id="t3b" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#7A6000;spacingLeft=4;spacingTop=4;whiteSpace=wrap;" value="Any website, document, or email the agent encounters can contain hidden text designed to override its instructions. The agent cannot reliably distinguish between its user&#39;s legitimate instructions and adversarial instructions embedded in content by a third party.  The vendor with the most widely deployed agentic browser has acknowledged this may never be fully patched." vertex="1">
          <mxGeometry height="72" width="1083" x="44" y="396" as="geometry" />
        </mxCell>
        <mxCell id="wbg" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#FFCA2C;" value="" vertex="1">
          <mxGeometry height="80" width="1111" x="28" y="484" as="geometry" />
        </mxCell>
        <mxCell id="wbar" parent="1" style="rounded=0;fillColor=#856404;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="1111" x="28" y="484" as="geometry" />
        </mxCell>
        <mxCell id="wt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#856404;" value="Most Teams Get This Wrong" vertex="1">
          <mxGeometry height="18" width="400" x="44" y="490" as="geometry" />
        </mxCell>
        <mxCell id="wb" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#7A6000;whiteSpace=wrap;" value="Treating these as three separate risks to be mitigated independently. They interact: inherited access gives injection attacks more to work with, and Same-Origin collapse means a successful injection can reach across every open session at once. The combination is more dangerous than any individual component." vertex="1">
          <mxGeometry height="46" width="1083" x="44" y="510" as="geometry" />
        </mxCell>
        <mxCell id="dfbg" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F2FBF4;strokeColor=#81C784;" value="" vertex="1">
          <mxGeometry height="64" width="1111" x="28" y="576" as="geometry" />
        </mxCell>
        <mxCell id="dfbar" parent="1" style="rounded=0;fillColor=#1B5E20;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="4" width="1111" x="28" y="576" as="geometry" />
        </mxCell>
        <mxCell id="dft" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1B5E20;" value="Decision Framework Preview" vertex="1">
          <mxGeometry height="14" width="400" x="44" y="582" as="geometry" />
        </mxCell>
        <mxCell id="dfb" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#2E7D32;whiteSpace=wrap;" value="Each component needs its own mitigation. Session isolation addresses inheritance. Dedicated profiles address Same-Origin collapse. Prompt injection requires content sandboxing and behavioral monitoring, not just input filtering. No single control addresses all three." vertex="1">
          <mxGeometry height="36" width="1083" x="44" y="598" as="geometry" />
        </mxCell>
