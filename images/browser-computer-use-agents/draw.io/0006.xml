        <mxCell id="c2b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333D4D;whiteSpace=wrap;" value="Dedicated browser profiles for agent sessions, authenticated only to the specific applications the agent is authorized to access for the specific task assigned. Prevents inheritance of unrelated sessions structurally, not through runtime content filtering. Structure is the control; filtering is not." vertex="1">
