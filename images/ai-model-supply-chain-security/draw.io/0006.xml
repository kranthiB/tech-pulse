        <mxCell id="l2hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" value="Layer 2: ML-BOM Provenance Documentation" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="200" as="geometry" />
        </mxCell>
        <mxCell id="l2bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#CBD8EF;" value="" vertex="1">
          <mxGeometry height="60" width="1111" x="28" y="244" as="geometry" />
        </mxCell>
        <mxCell id="l2b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333D4D;whiteSpace=wrap;" value="Version-controlled technical artifact capturing registry source, hashes, training data provenance, adapter source and hash, quantization toolchain. Updated on every component change. Specific enough to reconstruct the deployed model from source components during an incident." vertex="1">
          <mxGeometry height="52" width="1083" x="44" y="248" as="geometry" />
        </mxCell>
        <mxCell id="l3hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;strokeColor=none;" value="" vertex="1">
