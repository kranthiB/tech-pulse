        <mxCell id="l1b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333D4D;whiteSpace=wrap;" value="Pin the sha256 hash of every checkpoint, adapter, and quantized variant. Verify at load time, not just at download time. Any mismatch is a security event. Cost: negligible. Value: catches substitution, tampering, and silent updates across all four provenance failure points." vertex="1">
          <mxGeometry height="52" width="1083" x="44" y="132" as="geometry" />
        </mxCell>
        <mxCell id="l2hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;strokeColor=none;" value="" vertex="1">
