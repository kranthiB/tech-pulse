        <mxCell id="l1hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" value="Layer 1: Artifact Integrity Verification at Every Load" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="84" as="geometry" />
        </mxCell>
        <mxCell id="l1bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#CBD8EF;" value="" vertex="1">
          <mxGeometry height="60" width="1111" x="28" y="128" as="geometry" />
