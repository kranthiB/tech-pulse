        </mxCell>
        <mxCell id="l4hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" value="Layer 4: Safe Serialization Format Adoption" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="444" as="geometry" />
        </mxCell>
        <mxCell id="l4bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2FBF4;strokeColor=#81C784;" value="" vertex="1">
          <mxGeometry height="60" width="1111" x="28" y="488" as="geometry" />
        </mxCell>
        <mxCell id="l4b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#2E7D32;whiteSpace=wrap;" value="Migrate from serialization formats that execute code at load time to formats designed to be safe for untrusted model files. Prioritize by distribution scope: broadly distributed checkpoints should migrate first. Major hosting platforms support safe alternatives." vertex="1">
          <mxGeometry height="52" width="1083" x="44" y="492" as="geometry" />
