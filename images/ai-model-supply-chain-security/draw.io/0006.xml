        </mxCell>
        <mxCell id="l3hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" value="Layer 3: Pipeline Integrity Controls for Fine-Tuning and Adaptation" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="316" as="geometry" />
        </mxCell>
        <mxCell id="l3bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#CBD8EF;" value="" vertex="1">
          <mxGeometry height="72" width="1111" x="28" y="360" as="geometry" />
        </mxCell>
        <mxCell id="l3b" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#333D4D;spacingLeft=4;spacingTop=4;whiteSpace=wrap;" value="Apply supply chain thinking to data and tooling entering fine-tuning pipelines. Document training data provenance. The key question: could this data have been tampered with between source and training run?  This is the control that addresses class two backdoor attacks that downstream scanning cannot detect. No artifact inspection after training will find a behavioral backdoor baked in through training data." vertex="1">
          <mxGeometry height="64" width="1083" x="44" y="364" as="geometry" />
        </mxCell>
