          <mxGeometry height="5" width="1111" x="28" y="628" as="geometry" />
        </mxCell>
        <mxCell id="wt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#856404;" value="Most Teams Get This Wrong" vertex="1">
          <mxGeometry height="18" width="400" x="44" y="634" as="geometry" />
        </mxCell>
        <mxCell id="wb" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#7A6000;whiteSpace=wrap;" value="Treating the four pillars as sequential projects to be funded and staffed after deployment pressure builds. They are a single pre-production readiness criterion. An organization that has not completed all four has not completed the engineering work required to deploy a production agent. It has completed the work required to deploy a demo." vertex="1">
