        <mxCell id="htitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" value="The Agentic Reliability Gap: Why the Demo Always Works and Production Never Does" vertex="1">
          <mxGeometry height="62" width="820" x="28" y="10" as="geometry" />
        </mxCell>
        <mxCell id="p1hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="36" width="1111" x="28" y="84" as="geometry" />
        </mxCell>
        <mxCell id="p1hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" value="Pillar 1: Data Readiness Audit Before Deployment" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="84" as="geometry" />
        </mxCell>
        <mxCell id="p1bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#CBD8EF;" value="" vertex="1">
          <mxGeometry height="60" width="1111" x="28" y="128" as="geometry" />
        </mxCell>
        <mxCell id="p1b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333D4D;whiteSpace=wrap;" value="Audit the data environment the agent will actually encounter in production, not the hand-picked data used to build and test the demo. Document where data is fragmented, stale, inconsistently schematized, or missing. Each gap is a reliability risk that will produce a step failure at a predictable rate once the agent hits it at production volume." vertex="1">
          <mxGeometry height="52" width="1083" x="44" y="132" as="geometry" />
        </mxCell>
        <mxCell id="p2hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="36" width="1111" x="28" y="200" as="geometry" />
        </mxCell>
        <mxCell id="p2hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" value="Pillar 2: Integration Resilience Engineering" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="200" as="geometry" />
        </mxCell>
        <mxCell id="p2bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#CBD8EF;" value="" vertex="1">
          <mxGeometry height="60" width="1111" x="28" y="244" as="geometry" />
        </mxCell>
        <mxCell id="p2b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333D4D;whiteSpace=wrap;" value="Test every integration the agent depends on against its full production failure mode surface: rate limits, timeout behaviors, schema changes, undocumented error codes. The agent reliability ceiling is set by the reliability floor of its worst integration. Identify that floor before deployment, not after the first production outage." vertex="1">
          <mxGeometry height="52" width="1083" x="44" y="248" as="geometry" />
        </mxCell>
        <mxCell id="p3hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="36" width="1111" x="28" y="316" as="geometry" />
        </mxCell>
        <mxCell id="p3hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" value="Pillar 3: Graduated Deployment With Reliability Thresholds" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="316" as="geometry" />
        </mxCell>
        <mxCell id="p3bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#CBD8EF;" value="" vertex="1">
          <mxGeometry height="72" width="1111" x="28" y="360" as="geometry" />
        </mxCell>
        <mxCell id="p3b" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#333D4D;spacingLeft=4;spacingTop=4;whiteSpace=wrap;" value="Set explicit reliability thresholds that must be met at each deployment stage before expanding to the next. A threshold is not a target; it is a gate. If the agent does not clear the gate at shadow mode, it does not proceed to limited rollout. If it does not clear at limited rollout, it does not proceed to broad deployment.  The threshold values should be set based on the compounding math from the per-step reliability analysis, not from intuition about what good looks like." vertex="1">
          <mxGeometry height="64" width="1083" x="44" y="364" as="geometry" />
        </mxCell>
        <mxCell id="p4hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="36" width="1111" x="28" y="444" as="geometry" />
        </mxCell>
        <mxCell id="p4hdrt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" value="Pillar 4: Verification Infrastructure Before the First Production User" vertex="1">
          <mxGeometry height="36" width="900" x="44" y="444" as="geometry" />
        </mxCell>
        <mxCell id="p4bg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2FBF4;strokeColor=#81C784;" value="" vertex="1">
          <mxGeometry height="60" width="1111" x="28" y="488" as="geometry" />
        </mxCell>
        <mxCell id="p4b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#2E7D32;whiteSpace=wrap;" value="Behavioral monitoring, anomaly detection, audit trail, and rollback capability must be operational before the first production user interacts with the agent. This is the infrastructure that allows the organization to know when something goes wrong and to contain and reverse it. Without it, the agent runs in a trust space that has not been designed." vertex="1">
          <mxGeometry height="52" width="1083" x="44" y="492" as="geometry" />
        </mxCell>
        <mxCell id="cpbg" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#1B3A6B;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="56" width="1111" x="28" y="560" as="geometry" />
        </mxCell>
        <mxCell id="cpt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#AACCFF;" value="The Closing Principle" vertex="1">
          <mxGeometry height="14" width="300" x="44" y="566" as="geometry" />
        </mxCell>
        <mxCell id="cpb" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#FFFFFF;whiteSpace=wrap;" value="The reliability gap closes from the engineering side or it does not close. The model that closes it for you is not coming. These four pillars are the engineering investment that closes it." vertex="1">
          <mxGeometry height="28" width="1083" x="44" y="582" as="geometry" />
        </mxCell>
        <mxCell id="wbg" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#FFCA2C;" value="" vertex="1">
          <mxGeometry height="72" width="1111" x="28" y="628" as="geometry" />
        </mxCell>
